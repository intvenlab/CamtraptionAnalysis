<Window x:Class="CamtraptionAnalysis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Camtraption Analysis"
        Height="720"
        Width="1100"
        MinHeight="480"
        MinWidth="800">
    <Window.Resources>
        <Style x:Key="TimelineRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEventRow}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransitionHighlight}" Value="True">
                    <Setter Property="Background" Value="#E8F4FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWakeHighlight}" Value="True">
                    <Setter Property="Background" Value="#D8F0D8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsModeChangeHighlight}" Value="True">
                    <Setter Property="Background" Value="#E8E0FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNoteHighlight}" Value="True">
                    <Setter Property="Background" Value="#FFFFF8E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarningHighlight}" Value="True">
                    <Setter Property="Background" Value="#FFE8CC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsErrorHighlight}" Value="True">
                    <Setter Property="Background" Value="#FFFFE8E8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderPathTextBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"
                     Text="Select a folder containing JPG files..." />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="Browse..."
                    Padding="16,6"
                    Click="BrowseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <Button x:Name="RunButton"
                    Content="Run Analysis"
                    Padding="16,6"
                    IsEnabled="False"
                    Click="RunButton_Click" />
            <Button x:Name="OpenReportFolderButton"
                    Content="Open Reports Folder"
                    Padding="16,6"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="OpenReportFolderButton_Click" />
            <CheckBox x:Name="ShowMismatchesOnlyCheckBox"
                      Content="Show issues only"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      IsEnabled="False"
                      Checked="ShowMismatchesOnlyCheckBox_Changed"
                      Unchecked="ShowMismatchesOnlyCheckBox_Changed" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar"
                         Grid.Column="0"
                         Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         IsIndeterminate="False"
                         Margin="0,0,8,0" />
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Ready" />
        </Grid>

        <Border Grid.Row="3"
                Margin="0,0,0,8"
                Padding="10"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Background="#FAFAFA">
            <TextBlock x:Name="SummaryTextBlock"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Run analysis to see summary." />
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,0,0,4"
                   FontWeight="SemiBold"
                   Text="Capture timeline (events + captures)" />

        <DataGrid x:Name="ObservationsDataGrid"
                  Grid.Row="5"
                  RowStyle="{StaticResource TimelineRowStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding CaptureTimeDisplay}"
                                    Width="170" />
                <DataGridTextColumn Header="File"
                                    Binding="{Binding SourceFile}"
                                    Width="160" />
                <DataGridTextColumn Header="Row"
                                    Binding="{Binding RowKind}"
                                    Width="70" />
                <DataGridTextColumn Header="Expected / Event"
                                    Binding="{Binding ExpectedModeDisplay}"
                                    Width="140" />
                <DataGridTextColumn Header="Actual / Detail"
                                    Binding="{Binding InferredMode}"
                                    Width="260" />
                <DataGridTextColumn Header="Logged"
                                    Binding="{Binding CopyrightMode}"
                                    Width="100" />
                <DataGridTextColumn Header="Match"
                                    Binding="{Binding ScheduleMatch}"
                                    Width="110" />
                <DataGridTextColumn Header="Shutter"
                                    Binding="{Binding ShutterTypeDisplay}"
                                    Width="90" />
                <DataGridTextColumn Header="Speed"
                                    Binding="{Binding ShutterSpeed}"
                                    Width="90" />
                <DataGridTextColumn Header="ISO"
                                    Binding="{Binding Iso}"
                                    Width="60" />
                <DataGridTextColumn Header="Flash FEC"
                                    Binding="{Binding FlashExposureComp}"
                                    Width="80" />
                <DataGridTextColumn Header="Serial"
                                    Binding="{Binding SerialNumber}"
                                    Width="120" />
                <DataGridTextColumn Header="Copyright"
                                    Binding="{Binding CopyrightText}"
                                    Width="220" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
